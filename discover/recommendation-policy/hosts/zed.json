{
  "$schema": "../../schema/recommendation-host-policy-override.schema.json",
  "schemaVersion": 1,
  "host": "zed",
  "presetRefs": {
    "targetConcerns": ["delivery-core"]
  },
  "policy": {
    "recommendationLimit": 90,
    "activationBudget": 110,
    "suggestedBundleId": "opencode-global",
    "maxPerSourceFamily": 8,
    "maxPerDuplicateGroup": 6,
    "maxPerAssetKind": {
      "instruction": 24,
      "mcp-server": 12,
      "extension": 12,
      "reference-pack": 12
    },
    "targetAssetKinds": [
      {
        "assetKind": "instruction",
        "minimum": 10,
        "weight": 3
      },
      {
        "assetKind": "mcp-server",
        "minimum": 4,
        "weight": 3
      }
    ]
  }
}
