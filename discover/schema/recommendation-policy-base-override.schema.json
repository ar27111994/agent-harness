{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-harness.local/discover/recommendation-policy-base-override.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "scoring": {
      "$ref": "./recommendation-policy-base.schema.json#/$defs/scoring"
    },
    "hostDefaults": {
      "$ref": "./recommendation-policy-base.schema.json#/$defs/hostPolicyPartial"
    },
    "presets": {
      "$ref": "./recommendation-policy-base.schema.json#/$defs/presets"
    },
    "concernKeywordMap": {
      "$ref": "./recommendation-policy-base.schema.json#/$defs/stringArrayRecord"
    },
    "taskModeKeywordMap": {
      "$ref": "./recommendation-policy-base.schema.json#/$defs/stringArrayRecord"
    },
    "domainKeywordGroups": {
      "$ref": "./recommendation-policy-base.schema.json#/$defs/stringArrayRecord"
    },
    "synonyms": {
      "$ref": "./recommendation-policy-base.schema.json#/$defs/stringArrayRecord"
    }
  }
}
