{
  "schemaVersion": 1,
  "phases": [
    {
      "id": "d0-demand-profile",
      "enabled": true,
      "inputs": ["."],
      "outputs": ["discover/output/demand-profile.json"]
    },
    {
      "id": "d1-source-refresh",
      "enabled": true,
      "inputs": ["discover/sources.json", "discover/selections.json"],
      "outputs": ["discover/output/source-index.json"]
    },
    {
      "id": "d2-metadata-harvest",
      "enabled": true,
      "inputs": ["discover/output/source-index.json"],
      "outputs": ["discover/catalog.assets.jsonl"]
    },
    {
      "id": "d3-normalize",
      "enabled": true,
      "inputs": ["discover/catalog.assets.jsonl"],
      "outputs": ["discover/output/catalog.normalized.jsonl"]
    },
    {
      "id": "d4-compatibility-classification",
      "enabled": true,
      "inputs": ["discover/output/catalog.normalized.jsonl"],
      "outputs": ["discover/output/catalog.classified.jsonl"]
    },
    {
      "id": "d5-evidence-enrichment",
      "enabled": true,
      "inputs": ["discover/output/catalog.classified.jsonl"],
      "outputs": ["discover/output/catalog.enriched.jsonl"]
    },
    {
      "id": "d6-dedupe-selection",
      "enabled": true,
      "inputs": [
        "discover/output/catalog.enriched.jsonl",
        "discover/selections.json"
      ],
      "outputs": ["discover/output/catalog.selected.jsonl"]
    },
    {
      "id": "d7-mirror-queue",
      "enabled": true,
      "inputs": [
        "discover/output/catalog.selected.jsonl",
        "mirror/policy.json"
      ],
      "outputs": [
        "mirror/audit/mirror-plan.json",
        "mirror/bundles/opencode-global.lock.json",
        "mirror/bundles/copilot-core.lock.json",
        "mirror/bundles/shared-mcp.lock.json",
        "mirror/bundles/community-stable.lock.json"
      ]
    }
  ]
}
