# Optional GitHub API token used by discovery and content fetches.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_API_VERSION=2022-11-28

# Pipeline batch sizes.
AGENT_HARNESS_REMOTE_BATCH_SIZE=15
AGENT_HARNESS_MIRROR_BATCH_SIZE=120
AGENT_HARNESS_INSTALL_BATCH_SIZE=250

# Recursive scan safety budgets.
AGENT_HARNESS_SCAN_MAX_FILES=10000
AGENT_HARNESS_SCAN_MAX_DEPTH=20
AGENT_HARNESS_SCAN_MAX_BYTES=52428800

# Optional override for the VS Code curated asset store.
AGENT_HARNESS_COPILOT_CURATED_ROOT=
