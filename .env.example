# Optional GitHub token for higher GitHub API throughput during discovery.
# Prefer a least-privileged token with public repository read access only.
GITHUB_PERSONAL_ACCESS_TOKEN=
# GITHUB_TOKEN=

# Optional AI-assisted enrichment. Disabled unless URL and API key are both set.
# Use an OpenAI-compatible chat completions endpoint.
AGENT_HARNESS_AI_ENRICHMENT_URL=
AGENT_HARNESS_AI_ENRICHMENT_API_KEY=
AGENT_HARNESS_AI_ENRICHMENT_MODEL=gpt-4o-mini

# GitHub REST API version and retry behavior.
GITHUB_API_VERSION=2022-11-28
AGENT_HARNESS_GITHUB_FETCH_RETRIES=3

# Discovery and lifecycle batch sizes.
AGENT_HARNESS_REMOTE_BATCH_SIZE=15
AGENT_HARNESS_MIRROR_BATCH_SIZE=120
AGENT_HARNESS_INSTALL_BATCH_SIZE=250

# Recursive scan budgets used by demand profiling.
AGENT_HARNESS_SCAN_MAX_DEPTH=14
AGENT_HARNESS_SCAN_MAX_FILES=20000
AGENT_HARNESS_SCAN_MAX_BYTES=50000000

# Optional mutable lifecycle state root. Defaults to the repository root when
# developing in this repo and workspace-local .agent-harness/ for packaged CLI use.
AGENT_HARNESS_STATE_ROOT=

# Optional platform path overrides. Most users should leave these unset.
# AGENT_HARNESS_HOME=
# XDG_CONFIG_HOME=
# APPDATA=
